{
  "name": "codex-remote-pc",
  "version": "0.2.1",
  "description": "Codex Remote Control - PC Bridge",
  "main": "src/main.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/ui/tailwind.css -o ./src/ui/app.css --minify",
    "build:virtual-micro-broker": "dotnet publish native/virtual-micro-broker/VirtualMicroBroker.csproj -c Release -r win-x64 --self-contained false",
    "build:esp32-audio-bridge": "dotnet publish native/esp32-audio-bridge/Esp32AudioBridge.csproj -c Release -r win-x64 --self-contained false",
    "prestart": "npm run build:css",
    "start": "electron .",
    "predev": "npm run build:css",
    "dev": "electron . --dev",
    "package": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/package-pc.ps1",
    "portable": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/package-pc.ps1",
    "package:app": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/package-pc.ps1",
    "package:driver": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/package-virtual-micro-driver.ps1"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "adm-zip": "^0.6.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^3.4.17"
  },
  "build": {
    "appId": "com.codex.remote",
    "productName": "Codex Remote",
    "artifactName": "CodexRemote-Portable-${version}.${ext}",
    "asar": true,
    "asarUnpack": [
      "src/platform/codex-shortcuts.ps1",
      "src/platform/codex-micro-draft-link.ps1",
      "src/platform/codex-task-list.ps1"
    ],
    "extraResources": [
      {
        "from": "native/virtual-micro-broker/bin/Release/net9.0-windows/win-x64/publish",
        "to": "virtual-micro"
      },
      {
        "from": "native/esp32-audio-bridge/bin/Release/net9.0-windows/win-x64/publish",
        "to": "esp32-audio"
      }
    ],
    "directories": {
      "output": "build/pc"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "hooks/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/app-icon.ico",
      "executableName": "CodexRemote",
      "requestedExecutionLevel": "asInvoker"
    }
  }
}
