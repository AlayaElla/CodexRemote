[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=09/21/2026,1.0.0.0
CatalogFile=CodexRemoteVirtualAudio.cat
PnpLockdown=1

[SourceDisksNames]
1=%DiskName%,,,
[SourceDisksFiles]
CodexRemoteVirtualAudio.sys=1
[DestinationDirs]
DriverCopy=13

[Manufacturer]
%Provider%=Models,NTamd64.10.0...22000
[Models.NTamd64.10.0...22000]
%DeviceName%=Install,ROOT\CodexRemoteVirtualAudio

[Install.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverCopy
AddReg=Install.AddReg

[Install.NT.Services]
AddService=CodexRemoteVirtualAudio,0x00000002,ServiceInstall
[Install.NT.Wdf]
KmdfService=CodexRemoteVirtualAudio,KmdfSection
[KmdfSection]
KmdfLibraryVersion=1.33
[ServiceInstall]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\CodexRemoteVirtualAudio.sys

[Install.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveSpeakerHeadphone%,WaveSpeaker
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_WaveSpeakerHeadphone%,WaveSpeaker
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveSpeakerHeadphone%,WaveSpeaker
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologySpeakerHeadphone%,TopologySpeaker
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologySpeakerHeadphone%,TopologySpeaker

[WaveSpeaker]
AddReg=WaveSpeaker.AddReg
[WaveSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%DeviceName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1

[TopologySpeaker]
AddReg=TopologySpeaker.AddReg
[TopologySpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%DeviceName%

[Install.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,CodexRemoteVirtualAudio.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceName%

[DriverCopy]
CodexRemoteVirtualAudio.sys

[Strings]
Provider="CodexRemote"
DiskName="CodexRemote Virtual Audio Driver"
DeviceName="CodexRemote Speakers"
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY="{00000000-0000-0000-0000-000000000000}"
KSNAME_WaveSpeakerHeadphone="WaveSpeakerHeadphone"
KSNAME_TopologySpeakerHeadphone="TopologySpeakerHeadphone"
PKEY_AudioEndpoint_Association="{1DA5D803-D492-4EDD-8C23-E0C0FFE2A6AF},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode="{1DA5D803-D492-4EDD-8C23-E0C0FFE2A6AF},7"
